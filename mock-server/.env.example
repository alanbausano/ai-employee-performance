PORT=4000

# --- GraphQL behavior ---
# Probability of a random 5xx error on any GraphQL request (0.0 - 1.0)
GRAPHQL_ERROR_RATE=0.05
# Latency range in ms added to every GraphQL request
GRAPHQL_MIN_LATENCY_MS=50
GRAPHQL_MAX_LATENCY_MS=800
# Max GraphQL requests per minute per client
GRAPHQL_RATE_LIMIT=60

# --- AI Insights behavior ---
# Latency range simulating LLM processing
AI_MIN_LATENCY_MS=200
AI_MAX_LATENCY_MS=5000
# Probability of a timeout (>10s, returns 504)
AI_TIMEOUT_RATE=0.05
# Probability of PII appearing in the AI summary
AI_PII_RATE=0.15
# Probability of a low-confidence result (<0.3)
AI_LOW_CONFIDENCE_RATE=0.10
# Max AI requests per minute per client
AI_RATE_LIMIT=10

# --- Telemetry ---
# Set to "verbose" to log received telemetry events to console
TELEMETRY_LOG_LEVEL=quiet
